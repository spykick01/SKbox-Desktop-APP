{
  "name": "skbox",
  "productName": "SKBox",
  "version": "1.15.0",
  "description": "SKBox: a console-style media center for PC",
  "main": "src/main.js",
  "author": "SK",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v33.4.9+wvcus",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.skbox.app",
    "productName": "SKBox",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SKBox",
      "artifactName": "SKBox-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "src/native/**"
    ],
    "electronVersion": "33.4.9",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "build/vmp-sign.js"
  }
}